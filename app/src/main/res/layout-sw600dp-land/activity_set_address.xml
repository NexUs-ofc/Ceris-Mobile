<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".view.SetAddressActivity">

    <Button
        android:id="@+id/registerBtn"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/address_button_gap"
        android:backgroundTint="@color/md_theme_primary"
        android:text="@string/endereco_registrar"
        android:textAllCaps="false"
        android:textColor="@color/md_theme_onPrimary"
        android:textSize="@dimen/text_size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fieldsLayout"
        app:layout_constraintWidth_max="@dimen/field_width" />


    <ImageView
        android:id="@+id/voltarBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/address_top_margin"
        android:contentDescription="@string/chat_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_button" />

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/address_top_margin"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/field_width">

        <TextView
            android:id="@+id/textView7"
        android:fontFamily="@font/huninn"
        app:fontFamily="@font/huninn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_endereco_titulo"
            android:textAlignment="center"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="@dimen/text_size_28" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/endereco_subtitulo"
            android:textAlignment="center"
            android:textColor="@color/md_theme_hint"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/fieldsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/address_section_gap"
        android:gravity="start"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintWidth_max="@dimen/field_width">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etl_cep"
            style="@style/InputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cepInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:hint="@string/endereco_cep"
                android:inputType="number"
                android:textColor="@color/md_theme_onBackground"
                android:imeOptions="actionNext"
                android:textColorHint="@color/md_theme_hint"
                android:textSize="@dimen/text_size_13" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etl_rua"
            style="@style/InputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ruaInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:hint="@string/endereco_rua"
                android:inputType="textPostalAddress"
                android:imeOptions="actionNext"
                android:textColor="@color/md_theme_onBackground"
                android:textColorHint="@color/md_theme_hint"
                android:textSize="@dimen/text_size_13" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etl_numero"
                style="@style/InputStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/numeroInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="@string/cadastro_endereco_numero"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:textColor="@color/md_theme_onBackground"
                    android:textColorHint="@color/md_theme_hint"
                    android:textSize="@dimen/text_size_13" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etl_bairro"
                style="@style/InputStyle"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bairroInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="@string/endereco_bairro"
                    android:inputType="text"
                    android:textColor="@color/md_theme_onBackground"
                    android:imeOptions="actionNext"
                    android:textColorHint="@color/md_theme_hint"
                    android:textSize="@dimen/text_size_13" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etl_cidade"
                style="@style/InputStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cidadeInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="@string/endereco_cidade"
                    android:inputType="text"
                    android:textColor="@color/md_theme_onBackground"
                    android:imeOptions="actionNext"
                    android:textColorHint="@color/md_theme_hint"
                    android:textSize="@dimen/text_size_13" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etl_estado"
                style="@style/InputStyle"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/estadoInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="@string/endereco_estado"
                    android:inputType="text|textCapCharacters"
                    android:maxLength="2"
                    android:textColor="@color/md_theme_onBackground"
                    android:imeOptions="actionDone"
                    android:textColorHint="@color/md_theme_hint"
                    android:textSize="@dimen/text_size_13" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

    </LinearLayout>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="@dimen/hero_image_height"
        android:layout_marginEnd="-25dp"
        android:layout_marginBottom="-140dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/background_details" />


</androidx.constraintlayout.widget.ConstraintLayout>
