<?xml version="1.0" encoding="utf-8"?>
<!--
    Montserrat: fonte de todo o texto da interface.
    O titulo das telas usa Huninn e e aplicado no proprio TextView.

    Pesos estaticos em vez da fonte variavel porque o minSdk e 24, e eixos de
    peso variavel so valem a partir do 26.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/montserrat_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/montserrat_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/montserrat_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/montserrat_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
