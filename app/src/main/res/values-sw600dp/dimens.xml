<?xml version="1.0" encoding="utf-8"?>
<!--
    Tablet. Vale a partir de 600dp de menor largura, padrão recomendado pelo Android.

    O Galaxy Tab A7 Lite tem 1340x800 em 8.7 polegadas (~179 dpi). Conforme o
    Android reporte sua densidade normal, a menor largura fica acima de 600dp.
    Celulares e dobráveis estreitos permanecem com as medidas compactas.

    A regra nao e esticar: o conteudo cresce ate content_max_width e centraliza,
    e as grades passam a duas colunas.
-->
<resources>

    <dimen name="content_max_width">680dp</dimen>

    <dimen name="field_width">560dp</dimen>
    <dimen name="field_height">76dp</dimen>
    <dimen name="field_corner_radius">38dp</dimen>

    <dimen name="button_height">72dp</dimen>

    <dimen name="screen_margin_horizontal">60dp</dimen>
    <dimen name="spacing_xs">8dp</dimen>
    <dimen name="spacing_s">14dp</dimen>
    <dimen name="spacing_m">24dp</dimen>
    <dimen name="spacing_l">38dp</dimen>
    <dimen name="spacing_xl">52dp</dimen>
    <dimen name="spacing_xxl">80dp</dimen>

    <!-- Em tela grande, texto de celular fica visualmente pequeno mesmo em sp. -->
    <dimen name="text_size_10">13sp</dimen>
    <dimen name="text_size_12">15sp</dimen>
    <dimen name="text_size_13">16sp</dimen>
    <dimen name="text_size_14">17sp</dimen>
    <dimen name="text_size_15">18sp</dimen>
    <dimen name="text_size_16">20sp</dimen>
    <dimen name="text_size_18">22sp</dimen>
