<?xml version="1.0" encoding="utf-8"?>
<!--
    Tablet. Vale a partir de 480dp de menor largura.

    O Galaxy Tab A7 Lite tem 1340x800 em 8.7 polegadas (~179 dpi). Conforme o
    Android reporte 180 ou 240 dpi, a menor largura cai em 711dp ou 533dp - os
    dois casos entram aqui. Celulares ficam de fora: os maiores param perto de
    420dp de menor largura.

    A regra nao e esticar: o conteudo cresce ate content_max_width e centraliza,
    e as grades passam a duas colunas.
-->
<resources>

    <dimen name="content_max_width">600dp</dimen>

    <dimen name="field_width">480dp</dimen>
    <dimen name="field_height">68dp</dimen>
    <dimen name="field_corner_radius">34dp</dimen>

    <dimen name="button_height">64dp</dimen>

    <dimen name="screen_margin_horizontal">48dp</dimen>
    <dimen name="spacing_xs">6dp</dimen>
    <dimen name="spacing_s">12dp</dimen>
    <dimen name="spacing_m">20dp</dimen>
    <dimen name="spacing_l">32dp</dimen>
    <dimen name="spacing_xl">44dp</dimen>
    <dimen name="spacing_xxl">72dp</dimen>


    <!--
        Navegacao inferior. As quatro medidas abaixo tem uma regra entre si;
        mexer numa sem as outras desalinha a barra:

            nav_saliencia_raio = nav_scan_size / 2 + nav_cradle_margin
            nav_area_height    = nav_bar_height + nav_saliencia_raio
            (a margem de topo do botao e o proprio nav_cradle_margin)

        nav_bar_height e a faixa dos destinos; nav_area_height e ela mais o
        espaco que a saliencia ocupa acima.
    -->
    <dimen name="nav_bar_height">120dp</dimen>
    <dimen name="nav_icon_size">26dp</dimen>
    <dimen name="nav_label_text">13sp</dimen>
    <dimen name="nav_scan_size">84dp</dimen>
    <dimen name="nav_scan_icon_size">26dp</dimen>

    <dimen name="card_corner_radius">20dp</dimen>
    <dimen name="card_elevation">3dp</dimen>
    <dimen name="card_image_height">180dp</dimen>
    <dimen name="hero_image_height">420dp</dimen>
    <dimen name="list_item_height">88dp</dimen>
    <dimen name="avatar_size">128dp</dimen>

    <integer name="grid_columns">2</integer>

    <!-- Ilustracoes de estado vazio e botao flutuante secundario -->
