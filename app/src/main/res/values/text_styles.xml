<?xml version="1.0" encoding="utf-8"?>
<!--
    Tipografia das telas.

    O título é o único texto em Huninn; todo o resto herda Montserrat do tema.
-->
<resources>

    <style name="TituloTela">
        <item name="android:fontFamily">@font/huninn</item>
        <item name="fontFamily">@font/huninn</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>
        <item name="android:textSize">@dimen/text_size_20</item>
    </style>

    <!--
        Rótulos da barra de navegação. O destino ativo fica em semi bold; a cor
        não entra aqui porque vem do seletor em @color/nav_item_tint.
    -->
    <style name="RotuloNavInativo" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">@dimen/nav_label_text</item>
    </style>

    <style name="RotuloNavAtivo" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">@dimen/nav_label_text</item>
    </style>

    <!-- Texto dos chips de filtro: bold nos dois estados. -->
    <!--
        Tamanho do texto intocado. O que faz os quatro filtros caberem e o
        padding do chip, nao o corpo da fonte: medido com a Montserrat real
        numa tela de 393dp, o texto soma 261dp e sobram 361dp, entao o que
        precisava encolher era o ar de dentro do chip.
    -->
    <style name="TextoFiltroChip" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">@dimen/text_size_14</item>
    </style>

    <!-- Titulo de secao dentro da tela: "Supermercados proximos", "Receitas salvas". -->
    <style name="TituloSecao">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="fontFamily">@font/montserrat_semibold</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>
        <item name="android:textSize">@dimen/text_size_18</item>
    </style>

    <!--
        Atalho do chatbot. É TextView, não Chip: o Chip do Material traz ícone,
        altura e realce próprios, e aqui o desenho é só uma pílula branca com
        contorno e o texto em semi bold.
    -->
    <style name="SugestaoChat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chat_sugestao_altura</item>
        <item name="android:background">@drawable/bg_chat_sugestao</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="fontFamily">@font/montserrat_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/chat_sugestao_padding_h</item>
        <item name="android:paddingEnd">@dimen/chat_sugestao_padding_h</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="android:textSize">@dimen/text_size_12</item>
    </style>

</resources>
