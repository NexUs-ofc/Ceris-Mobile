<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="detalhe_produto_imagem_altura">280dp</dimen>
    <dimen name="detalhe_raio">12dp</dimen>
    <dimen name="detalhe_padding_cartao">16dp</dimen>

    <!-- Chip de validade, quantidade e status do Detalhe do Item. -->
    <style name="DetalheProdutoChip">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_detalhe_chip</item>
        <item name="android:paddingStart">@dimen/spacing_s</item>
        <item name="android:paddingEnd">@dimen/spacing_s</item>
        <item name="android:paddingTop">@dimen/spacing_s</item>
        <item name="android:paddingBottom">@dimen/spacing_s</item>
    </style>

    <style name="DetalheProdutoChipRotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/md_secundary_text</item>
        <item name="android:textSize">@dimen/text_size_10</item>
    </style>

    <style name="DetalheProdutoChipValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:textColor">@color/card_titulo</item>
        <item name="android:textSize">@dimen/text_size_13</item>
    </style>
</resources>
