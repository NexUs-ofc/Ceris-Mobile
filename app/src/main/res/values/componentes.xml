<?xml version="1.0" encoding="utf-8"?>
<!--
    Pecas repetidas nos popups do Figma: titulo do sheet, campo de confirmacao,
    botao cheio, botao de contorno e o "Cancelar" sublinhado.
-->
<resources>

    <style name="BotaoPrincipal" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="cornerRadius">@dimen/botao_radius</item>
    </style>
</resources>
