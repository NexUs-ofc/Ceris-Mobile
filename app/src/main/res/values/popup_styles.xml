<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FormaPopupCeris" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialogo_radius</item>
    </style>

    <style name="FundoPopupCeris" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/md_theme_surface</item>
        <item name="shapeAppearance">@style/FormaPopupCeris</item>
    </style>

    <style name="TituloPopupCeris" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/huninn</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>
        <item name="android:textSize">@dimen/text_size_22</item>
    </style>

    <style name="CorpoPopupCeris" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textColor">@color/ceris_cinza</item>
        <item name="android:textSize">@dimen/text_size_14</item>
    </style>

    <style name="BotaoPopupCeris" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/md_theme_primary</item>
    </style>

    <style name="TemaPopupCeris" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/FundoPopupCeris</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TituloPopupCeris</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CorpoPopupCeris</item>
        <item name="buttonBarPositiveButtonStyle">@style/BotaoPopupCeris</item>
        <item name="buttonBarNegativeButtonStyle">@style/BotaoPopupCeris</item>
        <item name="buttonBarNeutralButtonStyle">@style/BotaoPopupCeris</item>
    </style>

    <style name="TemaCalendarioCeris" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorAccent">@color/md_theme_primary</item>
        <item name="android:colorAccent">@color/md_theme_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialogo</item>
        <item name="android:windowMinWidthMajor">87%</item>
        <item name="android:windowMinWidthMinor">87%</item>
    </style>
</resources>
