<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ceris_purple_100">#F2E2FF</color>
    <color name="ceris_purple_200">#E4C6FF</color>
    <color name="ceris_purple_300">#D7A9FF</color>
    <color name="ceris_deep_100">#9769BF</color>
    <color name="ceris_deep_200">#654680</color>
    <color name="ceris_deep_300">#4F2078</color>
    <color name="ceris_deep_400">#322340</color>
    <color name="ceris_white">#FFFFFF</color>
    <color name="ceris_black">#000000</color>
    <!-- Card de produto: destaque de quantidade e validade, e titulo em negrito. -->
    <color name="card_destaque">#6D28D9</color>
    <color name="card_titulo">#1E1B4B</color>
    <!--
        Cinzas neutros do Figma, fora da escala roxa. O merge da main apagou os
        três, mas os estilos que vieram desta branch continuaram apontando para
        eles: era o que quebrava o link dos recursos.
    -->
    <color name="ceris_cinza">#737380</color>

    <!--
        Borda de todo campo de entrada: formularios, busca, caixas de OTP e os
        campos do sheet. E o mesmo lilas claro do realce dos popups, para a
        selecao e o contorno falarem a mesma lingua.

        Era o cinza neutro #D9D9D9, medido nas telas de login e cadastro do
        Figma; trocado por decisao de design depois de ver nas telas.
    -->
    <color name="campo_borda">@color/ceris_purple_200</color>
    <!-- Placeholder: cinza neutro, medido no fundo da rampa das telas -->
    <color name="campo_placeholder">#737373</color>

    <!-- Borda e texto de campo com erro, como nas telas de login e cadastro -->
    <color name="campo_erro">#FE696C</color>

    <!-- Item selecionado do dropdown. Os outros ficam brancos. -->
    <color name="selecao_item">#F2EDFA</color>
    <color name="ceris_cinza_claro">#E2E2E9</color>

    <!--
        Realce de selecao dos popups e menus. O padrao do Material deriva do
        colorPrimary, que e o roxo escuro #4F2078: como fundo de item
        selecionado ele fica pesado e fora da paleta. O lilas claro quase nao
        se distinguia do fundo branco, entao e o cinza da escala que fica.
    -->
    <color name="selecao_realce">@color/ceris_cinza_claro</color>
    <color name="md_theme_onBackground">@color/ceris_deep_400</color>
    <color name="md_theme_onSurface">@color/ceris_deep_400</color>
    <color name="md_secundary_text">@color/ceris_deep_200</color>
    <color name="md_theme_hint">@color/campo_placeholder</color>
    <color name="md_theme_primary">@color/ceris_deep_300</color>
    <color name="md_theme_onPrimary">@color/ceris_white</color>
    <color name="md_theme_primaryContainer">@color/ceris_purple_100</color>
    <color name="md_theme_onPrimaryContainer">@color/ceris_deep_300</color>
    <color name="md_theme_primary_translucent">#CC4F2078</color>
    <color name="md_theme_secondary">@color/ceris_deep_200</color>
    <color name="md_theme_onSecondary">@color/ceris_white</color>
    <color name="md_theme_secondaryContainer">@color/ceris_purple_200</color>
    <color name="md_theme_onSecondaryContainer">@color/ceris_deep_300</color>
    <color name="md_theme_tertiary">@color/ceris_deep_100</color>
    <color name="md_theme_onTertiary">@color/ceris_white</color>
    <color name="md_theme_tertiaryContainer">@color/ceris_purple_300</color>
    <color name="md_theme_onTertiaryContainer">@color/ceris_deep_400</color>
    <color name="md_theme_background">@color/ceris_white</color>
    <color name="md_theme_surface">@color/ceris_white</color>
    <color name="md_theme_surfaceVariant">@color/ceris_purple_100</color>
    <color name="md_theme_onSurfaceVariant">@color/ceris_deep_200</color>
    <color name="md_theme_surfaceContainerLowest">@color/ceris_white</color>
    <color name="md_theme_surfaceContainerLow">@color/ceris_purple_100</color>
    <color name="md_theme_surfaceContainer">@color/ceris_purple_200</color>
    <color name="md_theme_surfaceContainerHigh">@color/ceris_purple_300</color>
    <color name="md_theme_surfaceContainerHighest">@color/ceris_deep_100</color>
    <color name="md_theme_outline">@color/ceris_deep_100</color>
    <color name="md_theme_outlineVariant">@color/ceris_purple_300</color>
    <color name="md_theme_error">#904A43</color>
    <color name="md_theme_onError">@color/ceris_white</color>
    <color name="md_theme_errorContainer">#FFDAD5</color>
    <color name="md_theme_onErrorContainer">#73342D</color>
    <!-- Card de produto -->
    <color name="card_contorno">#EDEDF2</color>

    <!-- Selos de situacao do produto -->
    <color name="selo_fresco_fundo">#D6F5E3</color>
    <color name="selo_fresco_texto">#0E8A4F</color>
    <color name="selo_vencendo_fundo">#FDEBD3</color>
    <color name="selo_vencendo_texto">#A5610B</color>
    <color name="selo_vencido_fundo">#FFDAD5</color>
    <color name="selo_vencido_texto">#73342D</color>
    <!-- Icone e rotulo inativos da barra: o mesmo cinza dos icones do Figma -->
    <color name="nav_contorno">@color/ceris_cinza</color>

    <!-- Traco do topo da barra: cinza claro, bem mais fraco que o texto -->
    <color name="nav_traco">@color/ceris_cinza_claro</color>

    <!-- Tela de Locais -->
    <color name="header_fundo">#FAFAFA</color>
    <color name="header_divisor">#EDEDF2</color>
    <color name="local_distancia_fundo">#E3EDFB</color>
    <color name="local_distancia_texto">#1F4B8E</color>
    <!-- Barra de progresso das listas -->
    <color name="progresso_trilho">#EDE3FA</color>
    <!-- Lista de compras -->
    <color name="lista_painel_fundo">#F2EDFA</color>
    <color name="lista_item_concluido">#9A94A8</color>
    <!-- Mantido como nome proprio porque tambem pinta o checkbox das listas -->
    <color name="campo_contorno">@color/campo_borda</color>
    <color name="stepper_fundo">#F3EDFB</color>
    <color name="sheet_alca">#D9D0E8</color>
    <!-- Chatbot (Figma > Protótipos > V1 > Chatbot) -->
    <color name="chat_fundo">#FAF8F0</color>
    <color name="chat_balao_bot">#E8DCFA</color>
    <!-- Creme do fundo com alfa: o padrão continua aparecendo sob o cabeçalho -->
    <color name="chat_header_fundo">#E6FAF8F0</color>
    <color name="chat_header_traco">#1A4F2078</color>
    <!-- Contorno dos campos do popup de confirmar produto e dos steppers -->
    <color name="campo_confirmacao">#D9C2EC</color>
    <!-- Camera: escurece o que fica fora da moldura de leitura -->
    <color name="mascara_camera">#99000000</color>
    <color name="camera_botao_fundo">#E6FFFFFF</color>
    <!-- Nome do item como saiu na nota: cinza escuro, abaixo do titulo -->
    <color name="nota_nome">#5C5A6B</color>
    <color name="pilula_produto_borda">#8E8E99</color>
    <!-- Fundo da dica sobre a camera e do modo nao escolhido -->
    <color name="camera_dica_fundo">#99000000</color>
</resources>
