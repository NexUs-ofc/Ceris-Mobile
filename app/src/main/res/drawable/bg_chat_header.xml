<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabecalho colado no topo, meio transparente: o padrao do fundo continua
    visivel por baixo e o conteudo some atras dele ao rolar.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chat_header_fundo" />
        </shape>
    </item>
    <item android:top="-1dp"
        android:left="-1dp"
        android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/chat_header_traco" />
        </shape>
    </item>
</layer-list>
