<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/spacing_m">

    <TextView
        android:id="@+id/numero_passo"
        android:layout_width="@dimen/receita_passo_numero_size"
        android:layout_height="@dimen/receita_passo_numero_size"
        android:background="@drawable/bg_receita_passo"
        android:fontFamily="@font/montserrat_semibold"
        android:gravity="center"
        android:textColor="@color/md_theme_primary"
        android:textSize="@dimen/text_size_12"
        tools:text="1" />

    <TextView
        android:id="@+id/texto_passo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/receita_card_espaco"
        android:layout_weight="1"
        android:minHeight="@dimen/receita_passo_numero_size"
        android:gravity="center_vertical"
        android:textColor="@color/card_titulo"
        android:textSize="@dimen/text_size_13"
        tools:text="Corte o frango em cubos e tempere com sal e pimenta" />

</LinearLayout>
