<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:minHeight="@dimen/receita_passo_card_altura"
    app:cardBackgroundColor="@color/ceris_white"
    app:cardCornerRadius="@dimen/receita_painel_raio"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:strokeColor="@color/ceris_cinza_claro"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="@dimen/receita_card_espaco"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/receita_painel_raio">

        <LinearLayout
            android:id="@+id/cabecalho_passo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/receita_passo_cabecalho_altura"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/numero_passo"
                android:layout_width="@dimen/receita_passo_numero_size"
                android:layout_height="@dimen/receita_passo_numero_size"
                android:background="@drawable/bg_receita_passo"
                android:fontFamily="@font/montserrat_semibold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/md_theme_primary"
                android:textSize="@dimen/text_size_14"
                tools:text="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/receita_card_espaco"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titulo_passo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:importantForAccessibility="no"
                    android:textColor="@color/card_titulo"
                    android:textSize="@dimen/text_size_14"
                    tools:text="Cortar e temperar o frango" />

                <TextView
                    android:id="@+id/dica_passo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:importantForAccessibility="no"
                    android:text="@string/receita_passo_abrir"
                    android:textColor="@color/receita_passo_texto_secundario"
                    android:textSize="@dimen/receita_passo_dica_tamanho" />

            </LinearLayout>

            <ImageView
                android:id="@+id/icone_passo"
                android:layout_width="@dimen/receita_passo_numero_size"
                android:layout_height="@dimen/receita_passo_numero_size"
                android:importantForAccessibility="no"
                android:padding="@dimen/spacing_xs"
                android:rotation="90"
                android:src="@drawable/ic_menu_chevron_right"
                app:tint="@color/md_theme_primary" />

        </LinearLayout>

        <TextView
            android:id="@+id/texto_passo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receita_card_espaco"
            android:lineSpacingExtra="@dimen/receita_passo_linha_espaco"
            android:textColor="@color/ceris_white"
            android:textSize="@dimen/text_size_13"
            android:visibility="gone"
            tools:text="Em uma tábua, corte o frango em cubos. Tempere com sal e pimenta e misture para distribuir bem o tempero." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
