<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialogo_padding">

        <TextView
            android:id="@+id/titulo_exclusao"
            style="@style/TituloSheet" />

        <TextView
            android:id="@+id/nome_exclusao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="@dimen/text_size_18" />

        <TextView
            android:id="@+id/mensagem_exclusao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:textColor="@color/md_secundary_text"
            android:textSize="@dimen/text_size_14" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar_exclusao"
            style="@style/BotaoPrincipal"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/lista_excluir_confirmar"
            android:textColor="@color/md_theme_onError"
            app:backgroundTint="@color/md_theme_error" />

        <TextView
            android:id="@+id/btn_cancelar_exclusao"
            style="@style/LinkCancelar"
            android:layout_marginTop="@dimen/spacing_s" />
    </LinearLayout>
</ScrollView>
