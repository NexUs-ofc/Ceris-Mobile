<?xml version="1.0" encoding="utf-8"?>
<!-- Criar ou renomear lista. Mesmo desenho do sheet de adicionar item. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/sheet_padding"
    android:paddingTop="@dimen/spacing_s"
    android:paddingEnd="@dimen/sheet_padding"
    android:paddingBottom="@dimen/sheet_padding_bottom">

    <View
        android:id="@+id/alca"
        android:layout_width="@dimen/sheet_alca_largura"
        android:layout_height="@dimen/sheet_alca_altura"
        android:background="@drawable/bg_sheet_alca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titulo_sheet"
        style="@style/TituloSheet"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/spacing_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alca"
        tools:text="Nova lista" />

    <TextView
        android:id="@+id/rotulo_nome_lista"
        style="@style/RotuloCampo"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="@string/lista_nome_rotulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo_sheet" />

    <EditText
        android:id="@+id/campo_nome_lista"
        style="@style/CampoFormulario"
        android:autofillHints="name"
        android:hint="@string/lista_nome_hint"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rotulo_nome_lista" />

    <TextView
        android:id="@+id/rotulo_data_lista"
        style="@style/RotuloCampo"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="@string/lista_data_rotulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campo_nome_lista" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/campo_data_lista"
        style="@style/BotaoContorno"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="start|center_vertical"
        app:icon="@drawable/ic_menu_calendar"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rotulo_data_lista"
        tools:text="Sem data" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirmar"
        style="@style/BotaoPrincipal"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/spacing_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campo_data_lista"
        tools:text="Criar lista" />

    <TextView
        android:id="@+id/btn_cancelar"
        style="@style/LinkCancelar"
        android:layout_marginTop="@dimen/spacing_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_confirmar" />

</androidx.constraintlayout.widget.ConstraintLayout>
