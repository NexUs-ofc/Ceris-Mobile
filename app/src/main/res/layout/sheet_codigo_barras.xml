<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmar dados do produto (Figma > Protótipos > qr code), aberto por cima
    da camera quando ela le um codigo de barras.

    So o que o desenho mostra: nome, validade e quantidade. Marca, embalagem,
    categoria e foto vem da base aberta e seguem para a Core sem ocupar a tela.
    Rola por dentro: com o teclado aberto o botao de confirmar continua
    alcancavel.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_padding"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/sheet_padding"
        android:paddingBottom="@dimen/sheet_padding_bottom">

        <View
            android:layout_width="@dimen/sheet_alca_largura"
            android:layout_height="@dimen/sheet_alca_altura"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_alca" />

        <TextView
            style="@style/TituloSheet"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/codigo_titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/codigo_subtitulo"
            android:textColor="@color/md_secundary_text"
            android:textSize="@dimen/text_size_13" />

        <TextView
            style="@style/RotuloCampo"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/codigo_nome" />

        <EditText
            android:id="@+id/campo_nome_codigo"
            style="@style/CampoConfirmacao"
            android:layout_width="match_parent"
            android:hint="@string/codigo_nome_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/RotuloCampo"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/codigo_validade" />

        <TextView
            android:id="@+id/campo_validade_codigo"
            style="@style/CampoConfirmacao"
            android:layout_width="match_parent"
            android:background="@drawable/bg_campo_confirmacao"
            android:clickable="true"
            android:drawablePadding="@dimen/spacing_s"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="@string/codigo_sem_validade"
            app:drawableEndCompat="@drawable/ic_menu_calendar"
            app:drawableTint="@color/md_theme_primary" />

        <TextView
            style="@style/RotuloCampo"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/codigo_quantidade" />

        <include
            android:id="@+id/stepper_codigo"
            layout="@layout/view_stepper"
            android:layout_width="match_parent"
            android:layout_height="@dimen/campo_altura"
            android:layout_marginTop="@dimen/spacing_s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar_codigo"
            style="@style/BotaoPrincipal"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/codigo_confirmar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar_codigo"
            style="@style/BotaoContorno"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/codigo_cancelar" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
