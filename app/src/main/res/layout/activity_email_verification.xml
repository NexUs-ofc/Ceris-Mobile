<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".view.EmailVerificationActivity">

    <ImageButton
        android:id="@+id/voltarBtn"
        android:layout_width="@dimen/icone_voltar_size"
        android:layout_height="@dimen/icone_voltar_size"
        android:layout_marginStart="@dimen/spacing_s"
        android:layout_marginTop="@dimen/spacing_xl"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/voltar"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_button" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/otp_top_margin"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:fontFamily="@font/huninn"
        app:fontFamily="@font/huninn"
        android:text="Verifique seu e-mail"
        android:textAlignment="center"
        android:textColor="@color/md_theme_onBackground"
        android:textSize="@dimen/text_size_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/otp_content_max_width" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:fontFamily="@font/huninn"
        app:fontFamily="@font/huninn"
        android:lineSpacingExtra="2dp"
        android:tag="exemplo@email.com"
        android:text="@string/otp_subtitle"
        android:textAlignment="center"
        android:textColor="@color/md_secundary_text"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintWidth_max="@dimen/otp_content_max_width"
        tools:text="Enviamos um código de verificação de 6 dígitos para o endereço exemplo@email.com" />

    <LinearLayout
        android:id="@+id/otpInputsRow"
        android:layout_width="0dp"
        android:layout_height="@dimen/otp_digit_height"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleText"
        app:layout_constraintWidth_max="@dimen/otp_content_max_width">

        <EditText
            android:id="@+id/otpDigitOne"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:textColor="@color/md_theme_onBackground"
            android:textColorHint="@color/md_theme_hint"
            android:maxLength="1"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitTwo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:textColor="@color/md_theme_onBackground"
            android:textColorHint="@color/md_theme_hint"
            android:maxLength="1"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitThree"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:textColor="@color/md_theme_onBackground"
            android:textColorHint="@color/md_theme_hint"
            android:maxLength="1"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitFour"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:textColor="@color/md_theme_onBackground"
            android:textColorHint="@color/md_theme_hint"
            android:maxLength="1"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitFive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:textColor="@color/md_theme_onBackground"
            android:textColorHint="@color/md_theme_hint"
            android:maxLength="1"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitSix"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:textColor="@color/md_theme_onBackground"
            android:textColorHint="@color/md_theme_hint"
            android:maxLength="1"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/confirmCodeBtn"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:backgroundTint="@color/md_theme_primary"
        android:fontFamily="@font/huninn"
        app:fontFamily="@font/huninn"
        android:text="Confirmar código"
        android:textAllCaps="false"
        android:textColor="@color/md_theme_onPrimary"
        android:textSize="@dimen/text_size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpInputsRow"
        app:layout_constraintWidth_max="@dimen/field_width" />

    <LinearLayout
        android:id="@+id/resendContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/spacing_l"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmCodeBtn"
        app:layout_constraintWidth_max="@dimen/otp_content_max_width">

        <LinearLayout
            android:id="@+id/resendRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resendText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/huninn"
                app:fontFamily="@font/huninn"
                android:text="Não recebeu o código?"
                android:textColor="@color/md_secundary_text"
                android:textSize="@dimen/text_size_14" />

            <TextView
                android:id="@+id/resendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/huninn"
                app:fontFamily="@font/huninn"
                android:text="Reenviar"
                android:textColor="@color/md_theme_primary"
                android:textSize="@dimen/text_size_14" />
        </LinearLayout>

        <TextView
            android:id="@+id/resendTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/huninn"
            app:fontFamily="@font/huninn"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Reenviar em 00:30"
            android:textColor="@color/md_theme_primary"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
