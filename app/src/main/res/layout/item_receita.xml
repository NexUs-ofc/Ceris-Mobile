<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_receita"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/receita_card_espaco"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:strokeColor="@color/ceris_cinza_claro"
    app:strokeWidth="@dimen/card_stroke_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/receita_card_altura"
        android:padding="@dimen/card_produto_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_receita"
            android:layout_width="@dimen/receita_card_imagem"
            android:layout_height="@dimen/receita_card_imagem"
            android:background="@color/receita_fundo"
            android:contentDescription="@string/receita_imagem"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/FormaImagemLocal" />

        <TextView
            android:id="@+id/txt_nome_receita"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/receita_card_espaco"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_medium"
            android:maxLines="2"
            android:textColor="@color/card_titulo"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintBottom_toTopOf="@id/grupo_tempo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_receita"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Frango ao molho" />

        <LinearLayout
            android:id="@+id/grupo_tempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/receita_card_espaco"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_receita"
            app:layout_constraintTop_toBottomOf="@id/txt_nome_receita">

            <ImageView
                android:id="@+id/icone_tempo"
                android:layout_width="@dimen/text_size_16"
                android:layout_height="@dimen/text_size_16"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu_clock"
                app:tint="@color/receita_tempo_texto" />

            <TextView
                android:id="@+id/txt_tempo_receita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:textColor="@color/receita_tempo_texto"
                android:textSize="@dimen/text_size_13"
                tools:text="45 min" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
