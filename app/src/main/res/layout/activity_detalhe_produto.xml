<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalhe do Item, conforme o protótipo do Figma.

    Informacao nutricional e botao de consumo aparecem so quando a Core passa
    esses dados; sem eles ficam ocultos, para nao mostrar valores inventados.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ceris_white"
    tools:context=".view.DetalheProdutoActivity">

    <!-- Cabecalho -->
    <LinearLayout
        android:id="@+id/cabecalho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin_horizontal"
        android:paddingEnd="@dimen/screen_margin_horizontal"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_detalhe_voltar"
            android:layout_width="@dimen/spacing_xl"
            android:layout_height="@dimen/spacing_xl"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detalhe_produto_voltar"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_seta_voltar"
            app:tint="@color/card_titulo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:fontFamily="@font/montserrat_semibold"
            android:text="@string/detalhe_produto_titulo"
            android:textColor="@color/card_titulo"
            android:textSize="@dimen/text_size_18" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_consumido"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecalho">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin_horizontal"
            android:paddingEnd="@dimen/screen_margin_horizontal"
            android:paddingBottom="@dimen/spacing_m">

            <!-- Cartao do produto -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                app:cardBackgroundColor="@color/ceris_white"
                app:cardCornerRadius="@dimen/detalhe_raio"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_contorno"
                app:strokeWidth="@dimen/card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/img_detalhe_produto"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/detalhe_produto_imagem_altura"
                        android:adjustViewBounds="false"
                        android:contentDescription="@string/produto_imagem"
                        android:padding="@dimen/spacing_s"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/detalhe_padding_cartao"
                        android:paddingEnd="@dimen/detalhe_padding_cartao"
                        android:paddingBottom="@dimen/detalhe_padding_cartao">

                        <TextView
                            android:id="@+id/txt_detalhe_nome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/card_titulo"
                            android:textSize="@dimen/text_size_16"
                            tools:text="Leite Integral Piracanjuba 1L" />

                        <TextView
                            android:id="@+id/txt_detalhe_categoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="@color/md_secundary_text"
                            android:textSize="@dimen/text_size_12"
                            tools:text="Categoria: Laticínios" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Validade, quantidade e status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/DetalheProdutoChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/DetalheProdutoChipRotulo"
                        android:text="@string/detalhe_produto_validade" />

                    <TextView
                        android:id="@+id/txt_detalhe_validade"
                        style="@style/DetalheProdutoChipValor"
                        tools:text="25/07" />

                </LinearLayout>

                <LinearLayout
                    style="@style/DetalheProdutoChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1">

                    <TextView
                        style="@style/DetalheProdutoChipRotulo"
                        android:text="@string/detalhe_produto_quantidade" />

                    <TextView
                        android:id="@+id/txt_detalhe_quantidade"
                        style="@style/DetalheProdutoChipValor"
                        tools:text="1 un" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chip_situacao"
                    style="@style/DetalheProdutoChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1">

                    <TextView
                        style="@style/DetalheProdutoChipRotulo"
                        android:text="@string/detalhe_produto_status" />

                    <TextView
                        android:id="@+id/txt_detalhe_situacao"
                        style="@style/DetalheProdutoChipValor"
                        tools:text="FRESCO" />

                </LinearLayout>

            </LinearLayout>

            <!-- Informacao nutricional: so aparece com dados da Core -->
            <LinearLayout
                android:id="@+id/bloco_nutricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="@string/detalhe_produto_nutricao"
                    android:textColor="@color/card_titulo"
                    android:textSize="@dimen/text_size_16" />

                <LinearLayout
                    android:id="@+id/tabela_nutricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="vertical"
                    android:background="@drawable/bg_detalhe_chip" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Consumo: so aparece quando a Core tem a acao -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_consumido"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:layout_marginBottom="@dimen/spacing_l"
        android:fontFamily="@font/montserrat_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/detalhe_produto_consumido"
        android:textColor="@color/ceris_white"
        android:textSize="@dimen/text_size_15"
        android:visibility="gone"
        app:backgroundTint="@color/md_theme_primary"
        app:cornerRadius="@dimen/detalhe_raio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
