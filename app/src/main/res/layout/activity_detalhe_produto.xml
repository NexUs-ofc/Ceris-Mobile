<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalhe do Item (Figma > Protótipos > V1 > detalhe-produto).

    Foto grande no topo do cartao, nome e categoria embaixo; validade,
    quantidade e status em tres cartoes; tabela nutricional por 100 g; e os
    dois botoes de baixa do estoque. A tabela vem do Open Food Facts e so
    aparece quando o produto e encontrado la.

    Rola inteira, botoes inclusive: no celular pequeno a tela passa da altura.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/header_fundo"
    tools:context=".view.DetalheProdutoActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/conteudo_detalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/detalhe_margem"
            android:paddingEnd="@dimen/detalhe_margem"
            android:paddingBottom="@dimen/spacing_l">

            <!-- Cabecalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/detalhe_topo"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_detalhe_voltar"
                    android:layout_width="@dimen/icone_voltar_size"
                    android:layout_height="@dimen/icone_voltar_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/detalhe_produto_voltar"
                    android:padding="@dimen/spacing_s"
                    android:src="@drawable/ic_menu_arrow_left"
                    app:tint="@color/md_theme_primary" />

                <TextView
                    style="@style/TituloTela"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="@string/detalhe_produto_titulo"
                    android:textColor="@color/card_titulo" />

            </LinearLayout>

            <!-- Cartao do produto -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                app:cardBackgroundColor="@color/ceris_white"
                app:cardCornerRadius="@dimen/detalhe_cartao_raio"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_contorno"
                app:strokeWidth="@dimen/card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/img_detalhe_produto"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/detalhe_produto_imagem_altura"
                        android:background="@color/ceris_white"
                        android:contentDescription="@string/produto_imagem"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ph_produto" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/detalhe_padding_cartao"
                        android:paddingTop="@dimen/spacing_m"
                        android:paddingEnd="@dimen/detalhe_padding_cartao"
                        android:paddingBottom="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/txt_detalhe_nome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/huninn"
                            android:textColor="@color/card_titulo"
                            android:textSize="@dimen/text_size_18"
                            app:fontFamily="@font/huninn"
                            tools:text="Leite Integral Piracanjuba 1L" />

                        <TextView
                            android:id="@+id/txt_detalhe_categoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="@color/ceris_cinza"
                            android:textSize="@dimen/text_size_13"
                            tools:text="Categoria: Laticínios" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Validade, quantidade e status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/DetalheProdutoChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/DetalheProdutoChipRotulo"
                        android:text="@string/detalhe_produto_validade" />

                    <TextView
                        android:id="@+id/txt_detalhe_validade"
                        style="@style/DetalheProdutoChipValor"
                        tools:text="25/07" />

                </LinearLayout>

                <LinearLayout
                    style="@style/DetalheProdutoChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1">

                    <TextView
                        style="@style/DetalheProdutoChipRotulo"
                        android:text="@string/detalhe_produto_quantidade" />

                    <TextView
                        android:id="@+id/txt_detalhe_quantidade"
                        style="@style/DetalheProdutoChipValor"
                        tools:text="1 un" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chip_situacao"
                    style="@style/DetalheProdutoChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/rotulo_situacao"
                        style="@style/DetalheProdutoChipRotulo"
                        android:text="@string/detalhe_produto_status" />

                    <TextView
                        android:id="@+id/txt_detalhe_situacao"
                        style="@style/DetalheProdutoChipValor"
                        android:textAllCaps="true"
                        tools:text="FRESCO" />

                </LinearLayout>

            </LinearLayout>

            <!-- Informacao nutricional: so aparece quando a base aberta tem o produto -->
            <LinearLayout
                android:id="@+id/bloco_nutricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/huninn"
                    android:text="@string/detalhe_produto_nutricao"
                    android:textColor="@color/card_titulo"
                    android:textSize="@dimen/text_size_18"
                    app:fontFamily="@font/huninn" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:cardBackgroundColor="@color/ceris_white"
                    app:cardCornerRadius="@dimen/detalhe_raio"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_contorno"
                    app:strokeWidth="@dimen/card_stroke_width">

                    <LinearLayout
                        android:id="@+id/tabela_nutricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:showDividers="middle"
                        android:divider="@drawable/divisor_tabela" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_consumido"
                style="@style/BotaoPrincipal"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/detalhe_produto_consumido" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_descartar"
                style="@style/BotaoContorno"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/detalhe_produto_descartar" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
