<?xml version="1.0" encoding="utf-8"?>
<!-- Fala de quem usa: balão roxo, encostado à direita. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <TextView
        android:id="@+id/texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_balao_usuario"
        android:lineSpacingExtra="3dp"
        android:maxWidth="@dimen/chat_balao_max_width"
        android:paddingStart="@dimen/chat_balao_padding_h"
        android:paddingTop="@dimen/chat_balao_padding_v"
        android:paddingEnd="@dimen/chat_balao_padding_h"
        android:paddingBottom="@dimen/chat_balao_padding_v"
        android:textColor="@color/md_theme_onPrimary"
        android:textSize="@dimen/text_size_14"
        tools:text="O que posso preparar para o jantar?" />

</FrameLayout>
