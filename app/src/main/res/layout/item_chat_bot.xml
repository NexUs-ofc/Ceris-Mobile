<?xml version="1.0" encoding="utf-8"?>
<!-- Fala da Cerita: balão lilás, encostado à esquerda. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <TextView
        android:id="@+id/texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_balao_bot"
        android:lineSpacingExtra="3dp"
        android:maxWidth="@dimen/chat_balao_max_width"
        android:paddingStart="@dimen/chat_balao_padding_h"
        android:paddingTop="@dimen/chat_balao_padding_v"
        android:paddingEnd="@dimen/chat_balao_padding_h"
        android:paddingBottom="@dimen/chat_balao_padding_v"
        android:textColor="@color/md_theme_onBackground"
        android:textSize="@dimen/text_size_14"
        tools:text="Oi! Posso ajudar a planejar compras, sugerir receitas ou conferir o que falta no estoque." />

</FrameLayout>
