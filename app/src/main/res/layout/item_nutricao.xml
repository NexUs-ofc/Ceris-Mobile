<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha da tabela nutricional: nome a esquerda, valor em negrito a direita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/detalhe_padding_cartao"
    android:paddingEnd="@dimen/detalhe_padding_cartao"
    android:paddingTop="@dimen/spacing_s"
    android:paddingBottom="@dimen/spacing_s">

    <TextView
        android:id="@+id/txt_nutriente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/card_titulo"
        android:textSize="@dimen/text_size_13" />

    <TextView
        android:id="@+id/txt_valor_nutriente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/card_titulo"
        android:textSize="@dimen/text_size_13" />

</LinearLayout>
