<?xml version="1.0" encoding="utf-8"?>
<!--
    Uma linha da tabela nutricional: nome a esquerda, valor em negrito roxo a
    direita. As linhas pares ganham fundo cinza pelo codigo, como no Figma.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/detalhe_padding_cartao"
    android:paddingTop="@dimen/nutricao_linha_padding"
    android:paddingEnd="@dimen/detalhe_padding_cartao"
    android:paddingBottom="@dimen/nutricao_linha_padding">

    <TextView
        android:id="@+id/txt_nutriente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/card_titulo"
        android:textSize="@dimen/text_size_14" />

    <TextView
        android:id="@+id/txt_valor_nutriente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/md_theme_primary"
        android:textSize="@dimen/text_size_14"
        app:fontFamily="@font/montserrat_bold" />

</LinearLayout>
