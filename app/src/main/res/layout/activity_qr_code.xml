<?xml version="1.0" encoding="utf-8"?>
<!--
    QR Code.

    Estrutura adaptativa: o conteudo cresce ate content_max_width e centraliza,
    em vez de esticar no tablet. Medidas sempre por @dimen.

    TODO conteudo: montar a partir do Figma (Prototipos > V1 > QR Code).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".view.QrCodeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/screen_margin_horizontal"
        android:paddingEnd="@dimen/screen_margin_horizontal"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

</androidx.constraintlayout.widget.ConstraintLayout>
