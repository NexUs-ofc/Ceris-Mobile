<?xml version="1.0" encoding="utf-8"?>
<!--
    Card de lista de compras (Figma > Protótipos > V1 > Minhas Listas).

    Quatro linhas: nome com a contagem à direita, o rótulo do progresso com o
    percentual à direita, a barra, e o valor total.

    A contagem e a categoria são dois TextViews e não um só: a contagem é roxa
    e semibold, a categoria é cinza e regular. Num texto único isso exigiria
    Spannable montado em código.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_lista"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_contorno"
    app:strokeWidth="@dimen/card_stroke_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_produto_padding">

        <TextView
            android:id="@+id/txt_nome_lista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_semibold"
            android:maxLines="1"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="@dimen/text_size_15"
            app:layout_constraintEnd_toStartOf="@id/txt_itens"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Lista de Compras" />

        <TextView
            android:id="@+id/txt_itens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/md_theme_primary"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintBaseline_toBaselineOf="@id/txt_nome_lista"
            app:layout_constraintEnd_toStartOf="@id/txt_categoria"
            tools:text="7 itens" />

        <TextView
            android:id="@+id/txt_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_secundary_text"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintBaseline_toBaselineOf="@id/txt_nome_lista"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text=" · Compras" />

        <TextView
            android:id="@+id/rotulo_progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/lista_progresso"
            android:textColor="@color/md_secundary_text"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_nome_lista" />

        <TextView
            android:id="@+id/txt_percentual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/md_theme_primary"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintBaseline_toBaselineOf="@id/rotulo_progresso"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="43%" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barra_progresso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:indicatorColor="@color/md_theme_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rotulo_progresso"
            app:trackColor="@color/progresso_trilho"
            app:trackCornerRadius="@dimen/progresso_altura"
            app:trackThickness="@dimen/progresso_altura"
            tools:progress="43" />

        <TextView
            android:id="@+id/txt_valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/md_theme_primary"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barra_progresso"
            tools:text="R$ 65,29" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
