<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.ResetPasswordActivity">

    <ImageView
        android:id="@+id/voltarBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="65dp"
        android:contentDescription="Voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_button" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="115dp"
        android:text="Redefinir senha"
        android:textColor="#333333"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="165dp"
        android:tag="exemplo@email.com"
        android:text="@string/otp_subtitle"
        android:textAlignment="center"
        android:textColor="#B3333333"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Enviamos um código de verificação de 6 dígitos para o endereço exemplo@email.com" />

    <LinearLayout
        android:id="@+id/otpInputsRow"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="245dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/otpDigitOne"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#333333"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitTwo"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#333333"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitThree"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#333333"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitFour"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#333333"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitFive"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#333333"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigitSix"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_otp_digit_selector"
            android:gravity="center"
            android:hint="-"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#333333"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etl_new_password"
        style="@style/InputStyle"
        android:layout_width="350dp"
        android:layout_height="60dp"
        android:layout_marginTop="315dp"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/newPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nova senha"
            android:inputType="textPassword"
            android:textColor="#333333"
            android:textColorHint="#B2333333"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etl_confirm_password"
        style="@style/InputStyle"
        android:layout_width="350dp"
        android:layout_height="60dp"
        android:layout_marginTop="383dp"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirme a nova senha"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:textColor="#333333"
            android:textColorHint="#B2333333"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/resetPasswordBtn"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_marginTop="460dp"
        android:backgroundTint="#4C1D95"
        android:text="Redefinir senha"
        android:textColor="#EEEEEE"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/resendRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="525dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Não recebeu o código? "
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/resendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Reenviar"
            android:textColor="#CC4C1D95"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="350dp"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="-80dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/background_details" />

</androidx.constraintlayout.widget.ConstraintLayout>
