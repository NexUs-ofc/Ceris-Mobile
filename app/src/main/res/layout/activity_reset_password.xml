<?xml version="1.0" encoding="utf-8"?>
<!-- Redefinir senha: mesma estrutura das telas de entrada, tudo encadeado. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".view.ResetPasswordActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="@dimen/hero_image_height"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="-80dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/background_details" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_margin_horizontal"
            android:paddingEnd="@dimen/screen_margin_horizontal"
            android:paddingBottom="@dimen/spacing_xl">

            <ImageView
                android:id="@+id/voltarBtn"
                android:layout_width="@dimen/icone_voltar_size"
                android:layout_height="@dimen/icone_voltar_size"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lista_voltar"
                android:padding="@dimen/spacing_s"
                android:src="@drawable/ic_menu_arrow_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_primary" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:fontFamily="@font/huninn"
                android:gravity="center"
                android:text="@string/redefinir_titulo"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="@dimen/text_size_32"
                app:fontFamily="@font/huninn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/voltarBtn" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:gravity="center"
                android:text="@string/redefinir_subtitulo"
                android:textColor="@color/md_theme_hint"
                android:textSize="@dimen/text_size_15"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleText"
                app:layout_constraintWidth_max="@dimen/field_width" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etl_new_password"
                style="@style/InputStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                app:endIconMode="password_toggle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitleText"
                app:layout_constraintWidth_max="@dimen/field_width">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/newPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="@string/redefinir_nova"
                    android:inputType="textPassword"
                    android:textColor="@color/md_theme_onBackground"
                    android:textColorHint="@color/md_theme_hint"
                    android:textSize="@dimen/text_size_13" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etl_confirm_password"
                style="@style/InputStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:endIconMode="password_toggle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etl_new_password"
                app:layout_constraintWidth_max="@dimen/field_width">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirmPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="@string/redefinir_confirmar"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textColor="@color/md_theme_onBackground"
                    android:textColorHint="@color/md_theme_hint"
                    android:textSize="@dimen/text_size_13" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetPasswordBtn"
                style="@style/BotaoPrincipal"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/redefinir_titulo"
                android:textSize="@dimen/text_size_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etl_confirm_password"
                app:layout_constraintWidth_max="@dimen/field_width" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
