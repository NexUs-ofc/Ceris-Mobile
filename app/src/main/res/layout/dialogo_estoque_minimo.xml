<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo"
    android:orientation="vertical"
    android:padding="@dimen/dialogo_padding"
    android:paddingBottom="@dimen/spacing_s">

    <TextView
        style="@style/TituloSheet"
        android:text="@string/estoque_minimo_titulo" />

    <TextView
        android:id="@+id/estado_estoque_minimo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="@font/huninn"
        android:text="@string/estoque_minimo_carregando"
        android:textColor="@color/ceris_cinza" />

    <include
        android:id="@+id/stepper_dialogo"
        layout="@layout/view_stepper"
        android:layout_width="match_parent"
        android:layout_height="@dimen/campo_altura"
        android:layout_marginTop="@dimen/spacing_l" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_salvar_dialogo"
        style="@style/BotaoPrincipal"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/detalhe_baixa_salvar" />

    <TextView
        android:id="@+id/btn_cancelar_dialogo"
        style="@style/LinkCancelar"
        android:layout_marginTop="@dimen/spacing_s" />
</LinearLayout>
