<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CerisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- O registro manual exige sessao e permissao de notificacoes. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <service
            android:name=".notification.CerisMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".notification.PushSyncJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name=".view.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.LoginLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.GoogleLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ceris" android:host="notification" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.DetalheEventoActivity"
            android:exported="false" />
        <activity
            android:name=".view.SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.EmailVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.OtpLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.SetAddressActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.AddressLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.ForgotPasswordLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.ResetPasswordOtpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.ResetPasswordVerifyLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.ResetPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.ResetPasswordLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".view.ErroActivity"
            android:exported="false" />
        <activity
            android:name=".view.ChatbotActivity"
            android:exported="false" />
        <activity
            android:name=".view.QrCodeActivity"
            android:exported="false" />
        <activity
            android:name=".view.DetalheProdutoActivity"
            android:exported="false" />
        <activity
            android:name=".view.DetalheReceitaActivity"
            android:exported="false" />
        <activity
            android:name=".view.ListaComprasActivity"
            android:exported="false" />
        <activity
            android:name=".view.DetalheLocalActivity"
            android:exported="false" />
    </application>

</manifest>
